# Server Environment Variables Template
PORT=5000
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/rest/v1/rpc/jwks

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary Credentials (Server-side Only - NEVER EXPOSE SECRET TO FRONTEND)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

